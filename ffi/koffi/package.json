{
  "name": "@weaming/tg-rich-markdown",
  "version": "0.1.0",
  "description": "Convert Markdown extensions to Telegram Rich Markdown through the Go parser and CLI",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "bin": {
    "tg-rich-markdown": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "package.json"
  ],
  "scripts": {
    "build": "bun run build:library && bun run build:cli",
    "build:library": "bun build ./src/index.ts --outdir ./dist --target node --format esm --external koffi",
    "build:cli": "bun build ./src/cli.ts --outdir ./dist --target node --format esm --external koffi",
    "bench:gramio-format": "bun run ./bench/gramio-format.bench.ts",
    "bench:tg-rich-markdown": "bun run ./bench/tg-rich-markdown.bench.ts",
    "test": "bun test",
    "postbuild": "chmod +x ./dist/cli.js",
    "prepublishOnly": "bun run build"
  },
  "engines": {
    "node": ">=16",
    "bun": ">=1.0"
  },
  "dependencies": {
    "koffi": "^3.1.4"
  },
  "optionalDependencies": {
    "@weaming/tg-rich-markdown-darwin-arm64": "0.1.0",
    "@weaming/tg-rich-markdown-darwin-x64": "0.1.0"
  },
  "devDependencies": {
    "@gramio/format": "^0.10.0",
    "marked": "^17.0.6"
  }
}
